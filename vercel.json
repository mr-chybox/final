{
  "version": 2,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "server.js",  "use": "@vercel/node"   }
  ],
  "routes": [
    { "src": "/api/(.*)",  "dest": "/server.js" },
    {
      "src": "/(.*\\.(css|js|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot))",
      "dest": "/public/$1"
    },
    { "src": "/(.*\\.html)", "dest": "/public/$1" },
    { "src": "/(.*)",        "dest": "/server.js" }
  ]
}
