# =============================================================
# Poricito Bazar — Environment Variables
# =============================================================
# Local:  cp .env.example .env  তারপর নিচের মান গুলো পূরণ করুন
# Vercel: Dashboard → Project Settings → Environment Variables
# NEVER commit the real .env file to git!
# =============================================================


# ─── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=production          # production | development


# ─── PostgreSQL — Option A: Single URL (Vercel/Neon/Supabase) ──
# Vercel-এ এটাই ব্যবহার করুন। নিচের individual vars লাগবে না।
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ─── PostgreSQL — Option B: Individual vars (local dev only) ───
# DATABASE_URL না থাকলে এগুলো ব্যবহার হয়
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=poricito_bazar
# DB_USER=postgres
# DB_PASSWORD=your_strong_password_here

# SQL query logging (development only)
DB_LOGGING=false


# ─── JWT Admin Authentication ────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=8h


# ─── Admin Credentials ────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_use_a_strong_password


# ─── User JWT ─────────────────────────────────────────────────
JWT_USER_EXPIRES_IN=30d


# ─── CORS (optional) ──────────────────────────────────────────
# নির্দিষ্ট domain থেকে API access দিতে চাইলে:
# ALLOWED_ORIGIN=https://your-app.vercel.app,https://yourdomain.com
# না দিলে সব origin-কে allow করবে (default)
